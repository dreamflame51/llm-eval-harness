# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.pytest_cache/
.deepeval/

# Chroma index - derived, rebuilt by ingest, and tied to the embedding model
# and chunk size. The corpus PDFs under data/corpus/ are tracked on purpose:
# eval/ground_truth.yaml quotes exact spans of those exact files, so without
# them the reference set cannot be checked and no metric can be reproduced.
data/chroma/

# Personal interview-prep notes. Kept on disk, out of a public repository.
docs/rehearsal.md

# Langfuse keys. The project's own numbers never depend on them - tracing is
# additive and off by default - but a leaked secret key is still a leaked key.
.env
docker/langfuse/.env
