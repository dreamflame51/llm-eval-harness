# Copy to .env and fill in. .env is gitignored; this file must never hold a real key.
# Nothing here is needed for the reported numbers: every one of them is
# recomputed from committed files with no key and no model.

# Tracing (optional, see docs/tracing.md). Off unless both keys are set and
# something is listening at the host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Hugging Face token, only for the gated meta-llama/Llama-Prompt-Guard-2-86M
# in scripts/injection_classifier.py (licence must be accepted on the Hub).
HF_TOKEN=
